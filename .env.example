# Public Firebase Web SDK configuration for local development.
# Use the values of the develop project (yeyo-systems-web) from the Firebase
# console: Project settings → Your apps → Web app. NEVER use production values.
# If left empty, the site falls back to mock data.
# Copy this file to .env.local (ignored by git).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only values. Never expose these variables with a NEXT_PUBLIC_ prefix.
# Not used by the static export; reserved for the metrics runtime (#2).
SYNC_API_SECRET=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
